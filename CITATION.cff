cff-version: 1.2.0
message: "If you use NHPulse, please cite this repository/version. If your work uses ROAST-derived modeling outputs, also cite the upstream ROAST paper listed in CITATION.md."
title: "NHPulse: individualized non-human-primate EEG/tES cap design with ROAST and capMaker"
type: software
authors:
  - family-names: "Snyder"
    given-names: "Adam"
abstract: "NHPulse is a MATLAB research workflow for individualized non-human-primate EEG/tES cap design, including synthetic examples, ROAST/capMaker integration, tES targeting, EEG interleaving, and cap-manufacturing STL export."
keywords:
  - "non-human primate"
  - "transcranial electrical stimulation"
  - "EEG"
  - "ROAST"
  - "3D printing"
repository-code: "https://github.com/adam-neuro/NHPulse"
url: "https://github.com/adam-neuro/NHPulse"
license: "GPL-3.0-or-later"
version: "0.1.0-alpha"
date-released: "2026-08-21"
references:
  - type: article
    title: "Realistic vOlumetric-Approach to Simulate Transcranial Electric Stimulation -- ROAST -- a fully automated open-source pipeline"
    authors:
      - family-names: "Huang"
        given-names: "Yu"
      - family-names: "Datta"
        given-names: "Abhishek"
      - family-names: "Bikson"
